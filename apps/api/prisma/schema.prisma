// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================
// ENUMS
// ======================

enum Role {
  SUPER_ADMIN
  DIRECTOR
  ADMIN
  CENSEUR
  BIBLIOTECAIRE
  SURVEILLANT
  TEACHER
  STUDENT
  PARENT
}

enum EstablishmentType {
  PRIMARY
  COLLEGE
  LYCEE
  MIXED
}

// ======================
// PHASE 0 - FONDA TIONS
// ======================

model Establishment {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  type      EstablishmentType @default(MIXED)
  logoUrl   String?  @map("logo_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users           UserEstablishment[]
  academicYears   AcademicYear[]
  cycles          Cycle[]
  levels          Level[]
  series          Series[]
  classrooms      Classroom[]
  subjects        Subject[]
  periods         Period[]

  @@map("establishments")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  phone           String?
  avatarUrl       String?   @map("avatar_url")
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  establishments UserEstablishment[]
  refreshTokens  RefreshToken[]

  @@map("users")
}

model UserEstablishment {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  establishmentId String   @map("establishment_id")
  role            Role
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([userId, establishmentId])
  @@map("user_establishments")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    // stocké hashé
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ======================
// PHASE 1 - ACADÉMIQUE
// ======================

model AcademicYear {
  id              String   @id @default(uuid())
  establishmentId String   @map("establishment_id")
  name            String   // "2025-2026"
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  isCurrent       Boolean  @default(false) @map("is_current")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  classrooms    Classroom[]
  periods       Period[]

  @@index([establishmentId, isCurrent])
  @@map("academic_years")
}

model Cycle {
  id              String   @id @default(uuid())
  establishmentId String   @map("establishment_id")
  name            String   // Primaire, Collège, Lycée...
  order           Int      @default(0)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  levels        Level[]

  @@map("cycles")
}

model Level {
  id              String   @id @default(uuid())
  establishmentId String   @map("establishment_id")
  cycleId         String   @map("cycle_id")
  name            String   // 6ème, 5ème, Seconde...
  order           Int      @default(0)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  cycle         Cycle         @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  series        Series[]
  classrooms    Classroom[]

  @@map("levels")
}

model Series {
  id              String   @id @default(uuid())
  establishmentId String   @map("establishment_id")
  levelId         String?  @map("level_id")
  name            String   // A, C, D, S, L...
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  level         Level?        @relation(fields: [levelId], references: [id], onDelete: SetNull)
  classrooms    Classroom[]

  @@map("series")
}

model Classroom {
  id              String   @id @default(uuid())
  establishmentId String   @map("establishment_id")
  academicYearId  String   @map("academic_year_id")
  levelId         String   @map("level_id")
  seriesId        String?  @map("series_id")
  name            String   // 6ème A, Terminale C...
  capacity        Int?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  level         Level         @relation(fields: [levelId], references: [id], onDelete: Cascade)
  series        Series?       @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  @@map("classrooms")
}

model Subject {
  id              String   @id @default(uuid())
  establishmentId String   @map("establishment_id")
  name            String
  code            String?  // MATH, FR, HG...
  description     String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@map("subjects")
}

model Period {
  id              String   @id @default(uuid())
  establishmentId String   @map("establishment_id")
  academicYearId  String   @map("academic_year_id")
  name            String   // Trimestre 1, Semestre 1...
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  order           Int      @default(0)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@map("periods")
}