// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================
// ENUMS
// ======================

enum Role {
  SUPER_ADMIN
  DIRECTOR
  ADMIN
  CENSEUR
  BIBLIOTECAIRE
  SURVEILLANT
  TEACHER
  STUDENT
  PARENT
}

enum EstablishmentType {
  PRIMARY
  COLLEGE
  LYCEE
  MIXED
}

// ======================
// PHASE 0 - FONDA TIONS
// ======================

model Establishment {
  id                  String   @id @default(uuid())
  name                String
  slug                String   @unique
  students            Student[]
  teachers            Teacher[]
  parents             Parent[]
  enrollments         Enrollment[]
  exams               Exam[]
  grades              Grade[]
  attendances         Attendance[]
  teacherAssignments  TeacherAssignment[]
  type                EstablishmentType @default(MIXED)
  logoUrl             String?  @map("logo_url")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  users               UserEstablishment[]
  academicYears       AcademicYear[]
  cycles              Cycle[]
  levels              Level[]
  series              Series[]
  classrooms          Classroom[]
  subjects            Subject[]
  periods             Period[]

  @@map("establishments")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  phone           String?
  avatarUrl       String?   @map("avatar_url")
  student         Student?
  teacher         Teacher?
  parent          Parent?
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  establishments UserEstablishment[]
  refreshTokens  RefreshToken[]
  recordedAttendances Attendance[]

  @@map("users")
}

model UserEstablishment {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  establishmentId String   @map("establishment_id")
  role            Role
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([userId, establishmentId])
  @@map("user_establishments")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    // stocké hashé
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ======================
// PHASE 1 - ACADÉMIQUE
// ======================

model AcademicYear {
  id                  String   @id @default(uuid())
  establishmentId     String   @map("establishment_id")
  name                String   // "2025-2026"
  startDate           DateTime @map("start_date")
  endDate             DateTime @map("end_date")
  isCurrent           Boolean  @default(false) @map("is_current")
  enrollments         Enrollment[]
  exams               Exam[]
  teacherAssignments  TeacherAssignment[]
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  classrooms    Classroom[]
  periods       Period[]

  @@index([establishmentId, isCurrent])
  @@map("academic_years")
}

model Cycle {
  id              String   @id @default(uuid())
  establishmentId String   @map("establishment_id")
  name            String   // Primaire, Collège, Lycée...
  order           Int      @default(0)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  levels        Level[]

  @@map("cycles")
}

model Level {
  id              String   @id @default(uuid())
  establishmentId String   @map("establishment_id")
  cycleId         String   @map("cycle_id")
  name            String   // 6ème, 5ème, Seconde...
  order           Int      @default(0)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  cycle         Cycle         @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  series        Series[]
  classrooms    Classroom[]

  @@map("levels")
}

model Series {
  id              String   @id @default(uuid())
  establishmentId String   @map("establishment_id")
  levelId         String?  @map("level_id")
  name            String   // A, C, D, S, L...
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  level         Level?        @relation(fields: [levelId], references: [id], onDelete: SetNull)
  classrooms    Classroom[]

  @@map("series")
}

model Classroom {
  id                  String   @id @default(uuid())
  establishmentId     String   @map("establishment_id")
  academicYearId      String   @map("academic_year_id")
  levelId             String   @map("level_id")
  seriesId            String?  @map("series_id")
  name                String   // 6ème A, Terminale C...
  capacity            Int?
  enrollments         Enrollment[]
  exams               Exam[]
  attendances         Attendance[]
  teacherAssignments  TeacherAssignment[]
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  level         Level         @relation(fields: [levelId], references: [id], onDelete: Cascade)
  series        Series?       @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  @@map("classrooms")
}

model Subject {
  id                  String   @id @default(uuid())
  establishmentId     String   @map("establishment_id")
  name                String
  code                String?  // MATH, FR, HG...
  description         String?
  exams               Exam[]
  teacherAssignments  TeacherAssignment[]
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@map("subjects")
}

model Period {
  id              String   @id @default(uuid())
  establishmentId String   @map("establishment_id")
  academicYearId  String   @map("academic_year_id")
  name            String   // Trimestre 1, Semestre 1...
  startDate       DateTime @map("start_date")
  endDate         DateTime @map("end_date")
  order           Int      @default(0)
  exams           Exam[]
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@map("periods")
}

model Student {
  id              String    @id @default(uuid())
  establishmentId String    @map("establishment_id")
  userId          String?   @unique @map("user_id") // optionnel (si l'élève a un compte)
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  matricule       String?   // numéro matricule
  gender          String?   // M / F
  dateOfBirth     DateTime? @map("date_of_birth")
  placeOfBirth    String?   @map("place_of_birth")
  phone           String?
  address         String?
  photoUrl        String?   @map("photo_url")
  enrollments     Enrollment[]
  grades          Grade[]
  attendances     Attendance[]
  parents         ParentStudent[]
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([establishmentId, matricule])
  @@map("students")
}

model Teacher {
  id              String    @id @default(uuid())
  establishmentId String    @map("establishment_id")
  userId          String?   @unique @map("user_id")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  matricule       String?
  gender          String?
  phone           String?
  email           String?
  address         String?
  specialty       String?   // spécialité / matière principale
  assignments     TeacherAssignment[]
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([establishmentId, matricule])
  @@map("teachers")
}

model Parent {
  id              String   @id @default(uuid())
  establishmentId String   @map("establishment_id")
  userId          String?  @unique @map("user_id")
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  phone           String?
  email           String?
  address         String?
  profession      String?
  students        ParentStudent[]
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("parents")
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

model Enrollment {
  id              String           @id @default(uuid())
  establishmentId String           @map("establishment_id")
  studentId       String           @map("student_id")
  classroomId     String           @map("classroom_id")
  academicYearId  String           @map("academic_year_id")
  status          EnrollmentStatus @default(PENDING)
  enrolledAt      DateTime?        @map("enrolled_at")
  notes           String?
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroom     Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId]) // un élève ne peut être inscrit qu'une fois par année
  @@map("enrollments")
}

enum ExamType {
  INTERROGATION
  DEVOIR
  COMPOSITION
  EXAMEN
  AUTRE
}

model Exam {
  id              String    @id @default(uuid())
  establishmentId String    @map("establishment_id")
  academicYearId  String    @map("academic_year_id")
  periodId        String?   @map("period_id")
  subjectId       String    @map("subject_id")
  classroomId     String?   @map("classroom_id") // null = pour plusieurs classes
  name            String
  type            ExamType  @default(DEVOIR)
  examDate        DateTime? @map("exam_date")
  maxScore        Float     @default(20) @map("max_score")
  coefficient     Float     @default(1)
  isPublished     Boolean   @default(false) @map("is_published")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  period        Period?       @relation(fields: [periodId], references: [id], onDelete: SetNull)
  subject       Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classroom     Classroom?    @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  grades        Grade[]

  @@map("exams")
}

model Grade {
  id              String   @id @default(uuid())
  establishmentId String   @map("establishment_id")
  examId          String   @map("exam_id")
  studentId       String   @map("student_id")
  score           Float?
  appreciation    String?
  isAbsent        Boolean  @default(false) @map("is_absent")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  exam          Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId]) // une seule note par élève par examen
  @@map("grades")
}

enum ParentRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

model ParentStudent {
  id         String         @id @default(uuid())
  parentId   String         @map("parent_id")
  studentId  String         @map("student_id")
  relation   ParentRelation @default(OTHER)
  isPrimary  Boolean        @default(false) @map("is_primary") // contact principal
  createdAt  DateTime       @default(now()) @map("created_at")

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@map("parent_students")
}

model TeacherAssignment {
  id              String   @id @default(uuid())
  establishmentId String   @map("establishment_id")
  teacherId       String   @map("teacher_id")
  subjectId       String   @map("subject_id")
  classroomId     String   @map("classroom_id")
  academicYearId  String   @map("academic_year_id")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  teacher       Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject       Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classroom     Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  academicYear  AcademicYear  @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, classroomId, academicYearId])
  @@map("teacher_assignments")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id              String           @id @default(uuid())
  establishmentId String           @map("establishment_id")
  studentId       String           @map("student_id")
  classroomId     String           @map("classroom_id")
  date            DateTime         @db.Date
  status          AttendanceStatus @default(PRESENT)
  notes           String?
  recordedById    String?          @map("recorded_by_id") // user qui a fait l'appel
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroom     Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  recordedBy    User?         @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([studentId, date]) // une seule présence par élève par jour
  @@map("attendances")
}