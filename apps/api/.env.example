# Variables requises pour l'API Skools (ne jamais commiter .env).
DATABASE_URL="postgresql://skools:skools_secret@localhost:5432/skools?schema=public"
# Secret JWT obligatoire : le démarrage refuse sans lui (§8 roadmap).
JWT_SECRET="change-me-min-32-chars-en-prod"
# Origines frontend autorisées (CORS), séparées par des virgules.
# 5174 = port Vite de repli quand le 5173 est occupé.
FRONTEND_URL=http://localhost:5173,http://localhost:5174
# Port d'écoute (défaut 3000).
PORT=3000
